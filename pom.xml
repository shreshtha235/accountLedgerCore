<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ledger</groupId>
  <artifactId>account-ledger-core</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Account Ledger Core</name>
  <description>
    In-memory, append-only, bitemporal account ledger core. No persistence, no web layer,
    no database, and no runtime dependencies outside java.base.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <surefire.version>3.2.5</surefire.version>
    <exec.plugin.version>3.2.0</exec.plugin.version>
  </properties>

  <dependencies>
    <!-- Test scope only. The production code has no dependency outside java.base. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <!--
            The deliverable requires one deliberately failing test. It is tagged "failing" and
            excluded here so the default suite stays green, while remaining present and
            runnable on demand:  mvn test -Pfailing
          -->
          <excludedGroups>failing</excludedGroups>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.plugin.version}</version>
        <configuration>
          <mainClass>com.ledger.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn test -Pfailing  runs only the deliberately failing test -->
    <profile>
      <id>failing</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${surefire.version}</version>
            <configuration>
              <excludedGroups combine.self="override"/>
              <groups>failing</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
